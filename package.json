{
  "name": "arlinje",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Årlinje — a personal historical timeline: the events you have encountered, placed on one axis and connected",
  "homepage": "https://timeline.aslakhellevik.no",
  "repository": { "type": "git", "url": "https://github.com/aslakhellevik/timeline.git" },
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "demo": "vite --open /?demo",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "idb": "^8.0.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "fake-indexeddb": "^6.2.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "wrangler": "^4.155.0"
  }
}
